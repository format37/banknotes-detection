{
  "batch_size": 8,
  "epochs": 200,
  "lr": 1e-4,
  "weight_decay": 1e-4,
  "image_size": [1920, 1080],
  "num_classes": 24,
  "fpn_channels": 256,
  "strides": [8, 16, 32, 64, 128],
  "use_native_resolution": true,
  "focal_alpha": 0.25,
  "focal_gamma": 2.0,
  "lambda_reg": 1.0,
  "lambda_ctr": 1.0,
  "nms_threshold": 0.5,
  "score_threshold": 0.1,
  "max_detections": 10,
  "patience": 20,
  "grad_clip": 1.0,
  "warmup_epochs": 5,
  "hf_dataset": "format37/russian-rubles-banknotes",
  "hf_model_repo": "format37/fcos-banknotes-detector"
}
